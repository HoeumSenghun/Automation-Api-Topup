
language=en

# Switch merchant here, or pass the code as the first program argument.
# Merchant credentials live in .env (shared baseUrl plus {merchantCode}.* keys).
activeMerchant=ExampleTest

# Service options (pick one per run):
#   PINLESS = pinless topup,  refId TOPUPyymmdd0000 then 0001, 0002, ...
#   PINCODE = topup pincode,  refId PINCODEyymmdd0000 then 0001, 0002, ...
service=PINLESS

# PINLESS init body (used when service=PINLESS)
transAmount=1
currency=USD
customerPhoneNumber=YOUR_CUSTOMER_PHONE

# PINCODE init body (used only when service=PINCODE)
networkOperator=YOUR_OPERATOR
pinCodeId=YOUR_PIN_CODE_ID
# PINCODE ids: 1.5 (1.5 USD; alias 1_5), 1, 2, 5, 10, 20, 50, or a custom id
