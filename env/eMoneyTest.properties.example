# Copy this file to env/{merchantCode}.properties (gitignored).
# Example: env/eMoneyTest.properties, env/ePayTest.properties, env/acleda.properties, env/QRPAYMENT.properties
# Fill in real values locally. Never commit the copied .properties files.

baseUrl=https://YOUR-HOST:PORT
pin=YOUR_PIN
apiKey=YOUR_API_KEY
privateKey=YOUR_PRIVATE_KEY_BASE64
publicKey=YOUR_PUBLIC_KEY_BASE64

# Optional. Defaults are /{merchantCode}/telco/init, /{merchantCode}/telco/confirm, /{merchantCode}/trans/check
# initPath=/eMoneyTest/telco/init
# confirmPath=/eMoneyTest/telco/confirm
# checkPath=/eMoneyTest/trans/check
